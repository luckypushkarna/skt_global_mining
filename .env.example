# ==============================================================================
# SKT Global Mining & Services — Environment Variables Example
# ==============================================================================
# Copy this file to `.env.local` for local development.
# On Vercel, configure these in: Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Public Site URLs (Optional - Vercel automatically sets VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL)
# ------------------------------------------------------------------------------
# Explicit canonical site URL. Used for metadataBase, canonical URLs, sitemap.xml, robots.txt, and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://sktglobalmining.vercel.app
NEXT_PUBLIC_APP_URL=https://sktglobalmining.vercel.app
NEXT_PUBLIC_APP_NAME="SKT Global Mining & Services Limited"

# ------------------------------------------------------------------------------
# 2. Analytics & SEO Verification (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_VERIFICATION=your_google_site_verification_token_here

# ------------------------------------------------------------------------------
# 3. Contact Form & Email (Runtime - Required only if using direct SMTP endpoint)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
CONTACT_EMAIL=Info@sktglobalminings.com

# ------------------------------------------------------------------------------
# 4. Security & Rate Limiting (Runtime)
# ------------------------------------------------------------------------------
CSRF_SECRET=your_minimum_32_character_random_csrf_secret_string_here
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60000

# ------------------------------------------------------------------------------
# 5. Build-Time Flags (Optional)
# ------------------------------------------------------------------------------
# Set to true to bypass strict env checks during isolated build pipelines
SKIP_ENV_VALIDATION=false
